;; ── Polling variables ──────────────────────────────────────────────

(defpoll time
  :interval "30s"
  `date "+%a, %b %d %-I:%M %p"`)

(defpoll memory
  :interval "5s"
  `$HOME/.config/eww/scripts/memory`)

(defpoll volume
  :interval "1s"
  `$HOME/.config/eww/scripts/volume`)

(defpoll network
  :interval "5s"
  `$HOME/.config/eww/scripts/network`)

(defpoll battery
  :interval "10s"
  `$HOME/.config/eww/scripts/battery`)

(defpoll active_ws
  :interval "1s"
  `$HOME/.config/eww/scripts/workspaces`)

(defpoll openrouter
  :interval "60s"
  `$HOME/.config/eww/scripts/openrouter`)

;; ── Widgets ──────────────────────────────────────────────────────

(defwidget launcher []
  (box :class "launcher" :hexpand false
    ""))

(defwidget workspaces-widget []
  (box :class "workspaces" :orientation "h" :spacing 0
    (for ws in "[\"1\",\"2\",\"3\",\"4\",\"5\",\"6\",\"7\",\"8\",\"9\",\"0\"]"
      (button :class {ws == active_ws ? "ws-btn ws-active" : "ws-btn"}
              :onclick "pinnacle client -e 'local Tag = require(\"pinnacle.tag\"); local t = Tag.get(\"${ws}\"); if t then t:switch_to() end'"
        {ws == active_ws ? "󱓻" : ws}))))

(defwidget clock []
  (box :class "clock"
    "  ${time}"))

(defwidget network-widget []
  (box :class "network"
    network))

(defwidget volume-widget []
  (box :class "volume"
    volume))

(defwidget memory-widget []
  (box :class "memory"
    memory))

(defwidget battery-widget []
  (box :class "battery"
    battery))

(defwidget openrouter-widget []
  (box :class "openrouter" :orientation "h" :spacing 4
    {openrouter == "" ? "󱚣 --" :
     "󱚣 ${openrouter.pct}% [$${openrouter.remaining}]"}))
     ;;"󱚣 ${openrouter.pct}% [$${openrouter.remaining}/$${openrouter.used}]"}))

;; ── Bar layout ───────────────────────────────────────────────────

(defwidget left []
  (box :orientation "h" :halign "start" :spacing 0 :space-evenly false
    (launcher)
    (workspaces-widget)))

(defwidget center []
  (box :orientation "h" :halign "center"
    (clock)))

(defwidget right []
  (box :orientation "h" :halign "end" :spacing 15 :space-evenly false
    (openrouter-widget)
    (network-widget)
    (volume-widget)
    (memory-widget)
    (battery-widget)))

(defwidget bar-layout []
  (centerbox :orientation "h"
    (left)
    (center)
    (right)))

;; ── Window ───────────────────────────────────────────────────────

(defwindow bar
  :monitor 0
  :geometry (geometry :x "0%" :y "0px" :width "100%" :height "26px" :anchor "top center")
  :stacking "fg"
  :exclusive true
  :namespace "eww-bar"
  (bar-layout))
