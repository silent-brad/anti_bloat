#!/usr/bin/env nu

let mem = sys mem
let used = ($mem.used | into int)
let total = ($mem.total | into int)
let pct = ($used * 100 / $total | math round)
let used_gb = ($used / 1024 / 1024 / 1024 | math round -p 0)
let total_gb = ($total / 1024 / 1024 / 1024 | math round -p 0)
$"󰍛 ($pct)% [($used_gb)/($total_gb) GB]"
