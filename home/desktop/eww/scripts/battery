#!/usr/bin/env nu

let bat_path = "/sys/class/power_supply/BAT0"
if not ($bat_path | path exists) {
    print ""
    exit 0
}

let cap = (try { open $"($bat_path)/capacity" | str trim | into int } catch { 0 })
let status = (try { open $"($bat_path)/status" | str trim } catch { "Unknown" })

if $status == "Charging" or $status == "Not charging" or $status == "Full" {
    print $"󰂄 ($cap)%"
} else if $cap <= 15 {
    print $"  ($cap)%"
} else if $cap <= 30 {
    print $"  ($cap)%"
} else if $cap <= 50 {
    print $"  ($cap)%"
} else if $cap <= 75 {
    print $"  ($cap)%"
} else {
    print $"  ($cap)%"
}
