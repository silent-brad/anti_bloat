#!/usr/bin/env nu

# Check for active ethernet
let eth_up = (do -i { ip link show } | complete | get stdout | lines | any {|l| $l =~ 'state UP' and $l =~ 'ether'})
if $eth_up {
  print "󰈀 100%"
  exit 0
}

# Check wifi via net from sys
let nets = (sys net)
let wifi = ($nets | where name =~ "wl" | first | default null)
if ($wifi == null) {
  print "󰖪 0%"
  exit 0
}

# Try reading signal from /proc/net/wireless
let signal = try {
  open /proc/net/wireless
    | lines
    | skip 2
    | first
    | split row -r '\s+'
    | get 3
    | str replace '.' ''
    | into int
} catch { null }

if ($signal == null) {
  print "  ?"
  exit 0
}

# Convert dBm to percentage (-90 to -30 range)
let pct = [([($signal + 90) * 100 / 60 100] | math min) 0] | math max
print $"  ($pct)%"
