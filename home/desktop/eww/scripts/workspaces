#!/usr/bin/env nu

# Poll active tag from Pinnacle
pinnacle client -e '
local Tag = require("pinnacle.tag")
local Output = require("pinnacle.output")
local op = Output.get_focused()
if op then
  for _, t in ipairs(op:tags()) do
    if t:active() then
      print(t:name())
      return
    end
  end
end
print("1")
'
