#!/usr/bin/env nu

let fallback = '{"credits":"--","used":"--","remaining":"--"}'
let secrets_file = ($env.HOME | path join ".config/nvim/lua/secrets.lua")

let key = if ($secrets_file | path exists) {
  open $secrets_file
    | lines
    | where { $in | str contains "openrouter_api_key" }
    | first
    | parse --regex 'openrouter_api_key\s*=\s*"(?P<key>[^"]+)"'
    | get key.0?
} else { null }

let key = if ($key == null or $key == "YOUR_KEY_HERE") {
  $env.OPENROUTER_API_KEY? | default null
} else { $key }

if ($key == null or $key == "") {
  print $fallback
  exit 0
}

let resp = try {
  http get -H ["Authorization" $"Bearer ($key)"] https://openrouter.ai/api/v1/credits
} catch {
  print $fallback
  exit 0
}

let total = $resp.data?.total_credits? | default null
let used = $resp.data?.total_usage? | default null

if ($total == null or $used == null) {
  print $fallback
  exit 0
}

let remaining = $total - $used

{ credits: ($total | into string -d 2), used: ($used | into string -d 2), remaining: ($remaining | into string -d 2) }
  | to json -r
  | print
